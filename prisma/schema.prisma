// Amigo Database Schema
// Supports both PostgreSQL (SaaS) and SQLite (Self-hosted) via environment variables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum SubscriptionStatus {
  BASIC
  PRO
  LIFETIME
}

enum WorkspaceType {
  PERSONAL
  SHARED
}

enum ExpenseType {
  SURVIVAL_FIXED // Fixed recurring (Spotify, Rent, Car Lease)
  SURVIVAL_VARIABLE // Variable recurring (Utilities: Luz, Água, Gás)
  LIFESTYLE // Daily variable spending
  PROJECT // Tagged to a specific project (e.g., Casa)
  INVESTMENT // Exchange/broker funding (Kraken, Trading212, etc.)
}

enum ExpenseStatus {
  PAID
  PENDING
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ExchangeProvider {
  KRAKEN
  TRADING212
  BINANCE
  BYBIT
  BYBIT_EU
  WALLET_ETH
  WALLET_SOL
  MANUAL // User-entered holdings that no API reports (staked, locked, vesting)
}

enum AssetType {
  CRYPTO
  ETF
  STOCK
  CASH
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  PARTIAL
  ERROR
}

enum PriceStatus {
  OK
  UNAVAILABLE
  STALE
}

enum TradeSide {
  BUY
  SELL
}

enum IncomeType {
  SALARY // Regular salary/wage
  FREELANCE // Freelance/contract work
  INVESTMENT // Dividends, capital gains
  SALE // OLX, marketplace sales
  GIFT // Money gifts
  REFUND // Refunds, cashback
  OTHER // Miscellaneous
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  username            String?            @unique // Optional username for login
  name                String?
  password            String? // Hashed, nullable for OAuth users
  image               String?
  emailVerified       DateTime?
  subscriptionStatus  SubscriptionStatus @default(BASIC)
  aiCredits           Int                @default(0)
  aiProcessingEnabled Boolean            @default(false) // Doubles as AI Advisor consent flag
  aiConsentAt         DateTime? // When user accepted/declined the AI advisor consent prompt
  activeWorkspaceId   String? // Currently selected workspace for multi-workspace support
  seenAnnouncements   String[]           @default([]) // Array of announcement IDs user has dismissed

  // Relations
  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  invitationsSent  WorkspaceInvitation[] @relation("InvitationsSent")
  apiTokens        ApiToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  code      String // 6-digit verification code
  userData  String   @db.Text // JSON: {name, username, email, hashedPassword}
  attempts  Int      @default(0) // Track failed verification attempts
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email])
  @@map("email_verification_tokens")
}

// Personal access tokens for the iOS Shortcuts integration (Bearer auth).
// Only the sha256 hash is stored - the raw token is shown once at creation.
model ApiToken {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  name        String @db.VarChar(100) // e.g. "iPhone Wallet automation"
  tokenHash   String @unique // sha256 hex of the raw token
  tokenPrefix String @db.VarChar(12) // first chars for display, e.g. "amigo_a3f9"

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@index([userId])
  @@index([workspaceId])
  @@map("api_tokens")
}

// ============================================================================
// WORKSPACE (Multi-tenancy)
// ============================================================================

model Workspace {
  id      String        @id @default(cuid())
  name    String        @db.VarChar(100)
  type    WorkspaceType @default(PERSONAL)
  ownerId String

  // Onboarding
  onboardingCompleted Boolean @default(false)

  // Budget settings
  monthlyBudget        Decimal? @db.Decimal(12, 2) // Target monthly spending limit
  monthlySalary        Decimal? @db.Decimal(12, 2) // Monthly income for budgeting
  defaultCurrency      String   @default("EUR") @db.VarChar(3)
  defaultBankAccountId String? // Default bank account for new expenses
  language             String   @default("en") @db.VarChar(10) // User's preferred language (en, pt-PT, fr-FR)
  currencyDisplayMode  String   @default("converted") @db.VarChar(20) // "converted", "original", "original_only"

  // Relations
  owner               User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members             WorkspaceMember[]
  invitations         WorkspaceInvitation[]
  bankAccounts        BankAccount[]
  expenses            Expense[]
  projects            Project[]
  categories          Category[]
  recurringTemplates  RecurringTemplate[]
  incomes             Income[]
  exchangeConnections ExchangeConnection[]
  realAssets          RealAsset[]
  liabilities         Liability[]
  insights            Insight[]
  apiTokens           ApiToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        String @default("MEMBER") // OWNER, ADMIN, MEMBER

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id           String    @id @default(cuid())
  workspaceId  String
  invitedEmail String // Email of the person being invited
  invitedById  String // User who sent the invitation
  role         String    @default("MEMBER") // ADMIN or MEMBER (can't invite as OWNER)
  token        String    @unique // Unique token for invite link
  expiresAt    DateTime // Typically 7 days from creation
  acceptedAt   DateTime? // When the invitation was accepted

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, invitedEmail]) // One pending invite per email per workspace
  @@index([token])
  @@index([invitedEmail])
  @@map("workspace_invitations")
}

// ============================================================================
// BANK ACCOUNTS
// ============================================================================

model BankAccount {
  id          String  @id @default(cuid())
  workspaceId String
  name        String  @db.VarChar(100) // e.g., "Millennium Pessoal"
  balance     Decimal @default(0) @db.Decimal(12, 2)
  currency    String  @default("EUR") @db.VarChar(3)
  icon        String? @db.VarChar(50) // Optional icon identifier
  isActive    Boolean @default(true)

  // Relations
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses           Expense[]
  incomes            Income[]
  recurringTemplates RecurringTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bank_accounts")
}

// ============================================================================
// CATEGORIES
// ============================================================================

model Category {
  id          String  @id @default(cuid())
  workspaceId String
  parentId    String? // null = top-level parent category
  name        String  @db.VarChar(100)
  icon        String? @db.VarChar(50)
  color       String? @db.VarChar(7)
  isSystem    Boolean @default(false)

  // Relations
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent             Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           Category[]          @relation("CategoryHierarchy")
  expenses           Expense[]
  recurringTemplates RecurringTemplate[]
  keywordMappings    KeywordMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, parentId])
  @@map("categories")
}

// ============================================================================
// PROJECTS (The "Casa" Model)
// ============================================================================

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String    @db.VarChar(100) // e.g., "Casa", "Wedding", "Vacation"
  description String?   @db.VarChar(500)
  budget      Decimal?  @db.Decimal(12, 2) // Optional budget limit
  startDate   DateTime? // Project start date
  endDate     DateTime? // Project end date
  isActive    Boolean   @default(true)

  // Relations
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses           Expense[] // Many-to-many relation
  recurringTemplates RecurringTemplate[] // Many-to-many relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@map("projects")
}

// ============================================================================
// EXPENSES
// ============================================================================

model Expense {
  id            String  @id @default(cuid())
  workspaceId   String
  bankAccountId String?
  categoryId    String?

  // Core fields
  name        String        @db.VarChar(255) // Cleaned name (e.g., "McDonalds")
  rawInput    String?       @db.VarChar(500) // Original sloppy input for reference
  description String?       @db.VarChar(1000)
  type        ExpenseType   @default(LIFESTYLE)
  status      ExpenseStatus @default(PAID)

  // Amount handling with currency conversion
  amount           Decimal  @db.Decimal(12, 2) // Original value
  amountExpression String?  @db.VarChar(255) // Original math expression (e.g. "50+30")
  currency         String   @default("EUR") @db.VarChar(3) // Original currency
  amountEur        Decimal  @db.Decimal(12, 2) // Converted to EUR at entry time
  exchangeRate     Decimal? @db.Decimal(12, 6) // Rate used for conversion

  // Date fields
  date    DateTime // Transaction date
  dueDate DateTime? // For PENDING expenses
  paidAt  DateTime? // When actually paid

  // Metadata
  merchant            String?   @db.VarChar(255) // Normalized merchant name
  isRecurring         Boolean   @default(false)
  recurringTemplateId String? // Link to template if auto-generated
  installmentNumber   Int? // 1-based position within an installment plan (template.installmentMonths total)
  importLogId         String? // Link to import batch for bulk delete
  excludeFromBudget   Boolean   @default(false) // Don't count towards monthly budget (offshore/one-off)
  imageUrls           String?   @db.Text // JSON array of compressed WebP base64 data URLs
  categorizedAt       DateTime? // When this expense was categorized via tidy-up page

  // Split expense data
  splitCount Int? // Number of people splitting (null = not split)
  splitData  String? @db.Text // JSON array of {label, amount, locked} per person

  // Real-world asset linkage (vehicle TCO, etc.)
  realAssetId String?

  // Set when the expense was created through an iOS Shortcut, so the Shortcuts
  // endpoint can de-duplicate its own writes without touching anyone else's.
  apiTokenId String?

  // Relations
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projects          Project[] // Many-to-many: expense can have multiple tags
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  importLog         ImportLog?         @relation(fields: [importLogId], references: [id], onDelete: SetNull)
  realAsset         RealAsset?         @relation(fields: [realAssetId], references: [id], onDelete: SetNull)
  apiToken          ApiToken?          @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, date])
  @@index([workspaceId, type])
  @@index([workspaceId, categoryId])
  @@index([importLogId])
  @@index([realAssetId])
  @@index([apiTokenId, createdAt])
  @@map("expenses")
}

// ============================================================================
// RECURRING TEMPLATES (For auto-generating Survival expenses)
// ============================================================================

model RecurringTemplate {
  id            String  @id @default(cuid())
  workspaceId   String
  categoryId    String?
  bankAccountId String?

  name              String      @db.VarChar(255) // e.g., "Spotify", "Rent"
  type              ExpenseType // SURVIVAL_FIXED or SURVIVAL_VARIABLE
  amount            Decimal?    @db.Decimal(12, 2) // Fixed amount (null for variable)
  currency          String      @default("EUR") @db.VarChar(3)
  description       String?     @db.VarChar(500) // Notes copied to generated expenses
  excludeFromBudget Boolean     @default(false) // Generated expenses inherit this

  // Recurrence settings
  interval   RecurrenceInterval @default(MONTHLY)
  dayOfMonth Int? // 1-31, for monthly recurrence
  dayOfWeek  Int? // 0-6, for weekly recurrence

  // Auto-generation settings
  autoGenerate  Boolean   @default(false) // If true, auto-create at month start
  isActive      Boolean   @default(true)
  lastGenerated DateTime? // Last time an expense was auto-created
  nextDue       DateTime? // Next scheduled generation
  startDate     DateTime? // First occurrence date. Generation skips months before it. Anchor for installment numbering.
  endDate       DateTime? // Stop generating after this date (fixed-term plans, e.g. 6× installments). Null = open-ended.

  // Installment plans ("12x"): when set, this template is a fixed-term split of
  // installmentTotal over installmentMonths. amount holds the rounded monthly
  // share; the final installment absorbs the rounding remainder.
  installmentTotal  Decimal? @db.Decimal(12, 2)
  installmentMonths Int?

  // Relations
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  projects    Project[] // Many-to-many: tag templates with projects
  expenses    Expense[]
  liabilities Liability[]  @relation("LiabilityTemplate") // Loans linked to this monthly payment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recurring_templates")
}

// ============================================================================
// SMART PARSING (Level 1 - Local keyword mapping)
// ============================================================================

model KeywordMapping {
  id          String  @id @default(cuid())
  workspaceId String? // null = global/system mapping
  categoryId  String?

  keyword     String  @db.VarChar(100) // e.g., "mcd", "uber", "spotify"
  expenseType String? @db.VarChar(20) // e.g., "SURVIVAL_FIXED", "LIFESTYLE"
  isSystem    Boolean @default(false)

  // Relations
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, keyword])
  @@index([keyword])
  @@map("keyword_mappings")
}

// ============================================================================
// PURCHASE VERIFICATION (Anti-piracy)
// ============================================================================

model PurchaseReceipt {
  id          String    @id @default(cuid())
  userId      String
  platform    String // "apple" or "google"
  productId   String // The purchased product identifier
  receiptData String    @db.Text // The signed receipt
  isValid     Boolean   @default(false)
  verifiedAt  DateTime?
  expiresAt   DateTime? // For subscriptions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("purchase_receipts")
}

// ============================================================================
// IMPORT TRACKING
// ============================================================================

model ImportLog {
  id          String  @id @default(cuid())
  workspaceId String
  fileName    String
  fileType    String // "csv", "xlsx", "pdf"
  rowsTotal   Int     @default(0)
  rowsSuccess Int     @default(0)
  rowsFailed  Int     @default(0)
  errors      String? @db.Text // JSON array of error messages

  // Relations
  expenses Expense[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@map("import_logs")
}

// ============================================================================
// FEEDBACK & BUG REPORTS
// ============================================================================

enum FeedbackType {
  BUG
  FEATURE
}

model Feedback {
  id         String       @id @default(cuid())
  userId     String
  type       FeedbackType
  message    String       @db.Text
  imageUrl   String? // Optional screenshot URL (legacy, for single image)
  imageUrls  String?      @db.Text // JSON array of image URLs for multiple screenshots
  userAgent  String? // Browser/device info
  pageUrl    String? // Where user was when submitting
  isRead     Boolean      @default(false)
  isResolved Boolean      @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@map("feedback")
}

// ============================================================================
// INCOME TRACKING
// ============================================================================

model Income {
  id            String  @id @default(cuid())
  workspaceId   String
  bankAccountId String?

  // Core fields
  name        String     @db.VarChar(255) // e.g., "Salary", "OLX Sale - iPhone"
  description String?    @db.VarChar(1000)
  type        IncomeType @default(SALARY)

  // Amount handling
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("EUR") @db.VarChar(3)
  amountEur    Decimal  @db.Decimal(12, 2)
  exchangeRate Decimal? @db.Decimal(12, 6) // Rate used for conversion

  // Date
  date DateTime // When received

  // Recurrence (for salary/regular income)
  isRecurring Boolean             @default(false)
  interval    RecurrenceInterval?
  dayOfMonth  Int? // 1-31, for monthly income

  // Relations
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, date])
  @@index([workspaceId, type])
  @@map("incomes")
}

// ============================================================================
// PORTFOLIO TRACKING (Exchange connections, assets, snapshots)
// ============================================================================

model ExchangeConnection {
  id          String           @id @default(cuid())
  workspaceId String
  provider    ExchangeProvider
  label       String           @db.VarChar(100) // "My Kraken", "T212 Pie"

  // Wallet address (for WALLET_ETH, WALLET_SOL — public, no encryption needed)
  walletAddress String? @db.VarChar(100)

  // Encrypted credentials (AES-256-GCM) — optional for wallet providers
  encryptedApiKey    String? @db.Text
  encryptedApiSecret String? @db.Text
  encryptionIV       String? @db.VarChar(32) // hex IV
  encryptionTag      String? @db.VarChar(32) // GCM auth tag

  // Sync state
  syncStatus           SyncStatus @default(IDLE)
  lastSyncAt           DateTime?
  lastSyncError        String?    @db.VarChar(500)
  syncStartedAt        DateTime? // Set when sync begins; used to detect stuck SYNCING state
  tradeHistoryComplete Boolean    @default(false) // Flips true once we've paginated to empty

  // Cached account summary
  freeCash         Decimal? @db.Decimal(18, 2)
  freeCashCurrency String?  @db.VarChar(10)

  isActive Boolean @default(true)

  // Relations
  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    PortfolioAsset[]
  snapshots PortfolioSnapshot[]
  deposits  ExchangeDeposit[]
  trades    Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, provider, label])
  @@index([workspaceId])
  @@map("exchange_connections")
}

model PortfolioAsset {
  id                   String @id @default(cuid())
  exchangeConnectionId String

  // Asset identity
  symbol    String    @db.VarChar(20) // "BTC", "CSPX", "XDWL"
  name      String    @db.VarChar(200) // "Bitcoin", "iShares Core S&P 500"
  assetType AssetType

  // Holdings
  quantity           Decimal @db.Decimal(18, 8) // 8 decimal places for crypto
  averageBuyPrice    Decimal @db.Decimal(18, 8)
  averageBuyPriceEur Decimal @db.Decimal(18, 8)

  // Current valuation (updated on sync)
  currentPrice    Decimal @db.Decimal(18, 8)
  currentPriceEur Decimal @db.Decimal(18, 8)
  currentValue    Decimal @db.Decimal(18, 2) // quantity * currentPrice
  currentValueEur Decimal @db.Decimal(18, 2)

  // P&L
  totalCost        Decimal @db.Decimal(18, 2) // total invested
  totalCostEur     Decimal @db.Decimal(18, 2)
  unrealizedPnl    Decimal @db.Decimal(18, 2) // currentValue - totalCost
  unrealizedPnlEur Decimal @db.Decimal(18, 2)
  unrealizedPnlPct Decimal @db.Decimal(8, 4) // percentage P&L

  // Currency of the asset on the exchange (USDT/USDC/etc. so 10 chars; matches freeCashCurrency + Trade.currency)
  currency String @default("EUR") @db.VarChar(10)

  // Price availability — for assets we can hold but not price (delisted, no pair)
  priceStatus            PriceStatus @default(OK)
  priceUnavailableReason String?     @db.VarChar(200)

  // Locked / staked portion of quantity (e.g., Kraken .S balances, Bybit Earn)
  lockedQuantity Decimal? @db.Decimal(18, 8)

  // Realized P&L computed from Trade history (null until tradeHistoryComplete)
  realizedPnlEur Decimal? @db.Decimal(18, 2)

  // Marked dust (value < threshold and no trade history) — hidden from UI by default
  isDust Boolean @default(false)

  // Resolved CoinGecko coin id — set for MANUAL holdings so price refresh is exact
  // rather than guessed from the ticker (many symbols collide across chains).
  coingeckoId String? @db.VarChar(100)

  // When a MANUAL holding started counting toward the portfolio. The performance
  // chart marks this day so the step isn't misread as a gain.
  trackingStartedAt DateTime?

  lastUpdatedAt DateTime @default(now())

  // Relations
  exchangeConnection ExchangeConnection @relation(fields: [exchangeConnectionId], references: [id], onDelete: Cascade)

  @@unique([exchangeConnectionId, symbol])
  @@index([exchangeConnectionId])
  @@map("portfolio_assets")
}

model Trade {
  id                   String @id @default(cuid())
  exchangeConnectionId String

  externalId String    @db.VarChar(200) // exchange's own trade/execution ID
  symbol     String    @db.VarChar(20) // canonical base symbol (e.g., BTC, ATOM)
  side       TradeSide

  quantity    Decimal @db.Decimal(18, 8) // base asset quantity
  price       Decimal @db.Decimal(18, 8) // price per unit, in `currency`
  currency    String  @db.VarChar(10) // quote currency (USD, USDT, EUR, ...)
  fee         Decimal @default(0) @db.Decimal(18, 8)
  feeCurrency String  @db.VarChar(10)

  date DateTime

  exchangeConnection ExchangeConnection @relation(fields: [exchangeConnectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([exchangeConnectionId, externalId])
  @@index([exchangeConnectionId, symbol, date])
  @@index([exchangeConnectionId, date])
  @@map("trades")
}

model PortfolioSnapshot {
  id                   String @id @default(cuid())
  exchangeConnectionId String

  date             DateTime @db.Date
  totalValueEur    Decimal  @db.Decimal(18, 2)
  totalCostEur     Decimal  @db.Decimal(18, 2)
  unrealizedPnlEur Decimal  @db.Decimal(18, 2)
  freeCashEur      Decimal? @db.Decimal(18, 2)

  // Per-asset breakdown at this point in time
  assetBreakdown String? @db.Text // JSON

  exchangeConnection ExchangeConnection @relation(fields: [exchangeConnectionId], references: [id], onDelete: Cascade)

  @@unique([exchangeConnectionId, date])
  @@index([exchangeConnectionId, date])
  @@map("portfolio_snapshots")
}

model ExchangeDeposit {
  id                   String @id @default(cuid())
  exchangeConnectionId String

  externalId String   @db.VarChar(200) // exchange's own reference ID
  amount     Decimal  @db.Decimal(18, 2)
  currency   String   @db.VarChar(10)
  amountEur  Decimal  @db.Decimal(18, 2)
  date       DateTime

  // Link to expense system
  linkedExpenseId String? // null until user confirms
  dismissed       Boolean @default(false) // user said "ignore this"

  exchangeConnection ExchangeConnection @relation(fields: [exchangeConnectionId], references: [id], onDelete: Cascade)

  @@unique([exchangeConnectionId, externalId])
  @@index([exchangeConnectionId])
  @@map("exchange_deposits")
}

// ============================================================================
// REAL-WORLD ASSETS (Vehicles, Real Estate)
// ============================================================================

enum RealAssetType {
  VEHICLE
  PROPERTY
}

enum RealAssetStatus {
  ACTIVE
  SOLD
}

enum VehicleFuelType {
  PETROL
  DIESEL
  HYBRID
  EV
  OTHER
}

enum VehicleClass {
  CAR
  MOTORCYCLE
  BICYCLE
}

enum VehicleBodyType {
  // Cars
  SEDAN
  HATCHBACK
  SUV
  WAGON
  COUPE
  CONVERTIBLE
  TRUCK
  // Motorcycles
  NAKED
  SPORT
  CRUISER
  TOURING
  ADVENTURE
  SCOOTER
  OFF_ROAD
  // Bicycles (discipline — reuses bodyType for BICYCLE class)
  ROAD
  GRAVEL
  MTB
  HYBRID
  E_BIKE
  OTHER
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  OTHER
}

enum EnergyRating {
  A_PLUS
  A
  B
  B_MINUS
  C
  D
  E
  F
}

enum LiabilityType {
  VEHICLE_LOAN
  MORTGAGE
  CREDIT_CARD
  PERSONAL_LOAN
  STUDENT_LOAN
  INSTALLMENT
  OTHER
}

enum LiabilityStatus {
  ACTIVE
  PAID_OFF
  DEFAULTED
}

model RealAsset {
  id          String          @id @default(cuid())
  workspaceId String
  type        RealAssetType
  name        String          @db.VarChar(255)
  status      RealAssetStatus @default(ACTIVE)

  // Purchase
  purchasePrice    Decimal  @db.Decimal(14, 2)
  purchaseCurrency String   @default("EUR") @db.VarChar(3)
  purchasePriceEur Decimal  @db.Decimal(14, 2)
  purchaseDate     DateTime

  // Current valuation (refreshed by cron + on-demand)
  currentValue          Decimal?  @db.Decimal(14, 2)
  currentValueEur       Decimal?  @db.Decimal(14, 2)
  currentValueUpdatedAt DateTime?
  currentValueSource    String?   @db.VarChar(50) // "purchase", "web_archive", "live_scrape", "ai_estimate", "heuristic", "stand_virtual", "manual", "sale", "stale"

  // Async backfill state (Web Archive scrape on creation / spec change)
  backfillStatus     String?   @db.VarChar(20) // "queued" | "running" | "done" | "no_data"
  backfillProgress   Int? // 0..100 (or N out of total snapshot count)
  backfillStartedAt  DateTime?
  backfillFinishedAt DateTime?

  // Sale (status=SOLD)
  soldAt       DateTime?
  salePrice    Decimal?  @db.Decimal(14, 2)
  salePriceEur Decimal?  @db.Decimal(14, 2)
  saleCurrency String?   @db.VarChar(3)

  // Display
  imageUrl String? @db.VarChar(500)
  notes    String? @db.VarChar(2000)

  // Relations
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?
  property         Property?
  valuationHistory ValuationHistory[]
  liabilities      Liability[]
  expenses         Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, type, status])
  @@index([workspaceId, status])
  @@map("real_assets")
}

model Vehicle {
  realAssetId String @id

  vehicleClass VehicleClass @default(CAR)

  brand      String  @db.VarChar(100)
  model      String  @db.VarChar(100)
  generation String? @db.VarChar(50) // e.g., "ND" for Miata
  year       Int
  trim       String? @db.VarChar(100)

  mileage          Int? // km
  mileageUpdatedAt DateTime?

  vin   String? @db.VarChar(17)
  plate String? @db.VarChar(20)
  color String? @db.VarChar(50)

  fuelType VehicleFuelType?
  bodyType VehicleBodyType?

  realAsset RealAsset @relation(fields: [realAssetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, model])
  @@map("vehicles")
}

model Property {
  realAssetId String @id

  propertyType PropertyType

  // Location (PT-centric, free-text + concelho key for INE valuation index)
  address    String? @db.VarChar(255)
  postalCode String? @db.VarChar(20)
  distrito   String? @db.VarChar(100)
  concelho   String? @db.VarChar(100)
  freguesia  String? @db.VarChar(100)
  country    String  @default("PT") @db.VarChar(2)

  // Physical
  livableAreaM2 Int?
  totalAreaM2   Int?
  bedrooms      Int?
  bathrooms     Int?
  yearBuilt     Int?
  floor         Int? // for apartments
  parkingSpaces Int?
  energyRating  EnergyRating?

  // Recurring fees
  condominiumFeeMonthly Decimal? @db.Decimal(10, 2)

  // Geocode (postal-code → lat/lon via Nominatim, used for OSM static-map thumbnail)
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  geocodedAt   DateTime?
  geocodeError String?   @db.VarChar(40)

  realAsset RealAsset @relation(fields: [realAssetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([concelho])
  @@index([propertyType])
  @@map("properties")
}

model ValuationHistory {
  id          String @id @default(cuid())
  realAssetId String

  value    Decimal @db.Decimal(14, 2)
  valueEur Decimal @db.Decimal(14, 2)
  currency String  @default("EUR") @db.VarChar(3)
  // "purchase"     — anchor at purchase date (filled, solid dot)
  // "web_archive"  — historical scrape from archive.org (filled, solid dot)
  // "live_scrape"  — current cron scrape (filled, solid dot)
  // "ai_estimate"  — Z.AI fallback for gaps (hollow ring dot)
  // "manual"       — user-entered valuation (diamond dot)
  // "heuristic"    — legacy daily depreciation cron (kept for backwards compat)
  // "stand_virtual" / "sale" — legacy values; no new rows written
  source   String  @db.VarChar(50)

  // Number of comparable listings the median was derived from. Null for
  // ai_estimate, manual, purchase, and legacy heuristic rows.
  sampleSize Int?

  // Per-source structured context (e.g. {archiveDate, mileageBand, aiReasoning, note}).
  metadata Json?

  recordedAt DateTime @default(now())

  // Optional FK to the SpecMarketSnapshot that produced this row. Phase 1 of
  // the comparables-modal feature doesn't read this — added now so a future
  // chart-dot-click flow can resolve "which listings produced this dot"
  // without a data backfill.
  snapshotId String?
  snapshot   SpecMarketSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  realAsset RealAsset @relation(fields: [realAssetId], references: [id], onDelete: Cascade)

  @@index([realAssetId, recordedAt])
  @@index([snapshotId])
  @@map("valuation_history")
}

// AI-built dropdown taxonomy for the cascading vehicle wizard.
// Lazy populated: first user of a (year, make) combination triggers a
// Z.AI GLM-4.6 call; everyone after gets the cached result for free.
//
// `level` is one of "makes" | "models" | "trims".
// `parentKey` encodes the path: "2019" for makes, "2019|Mazda" for models,
// "2019|Mazda|MX-5" for trims.
// `values` is a JSON array of strings (the dropdown options at that level).
model VehicleTaxonomy {
  id        String   @id @default(cuid())
  level     String   @db.VarChar(20)
  parentKey String   @db.VarChar(255)
  values    Json
  source    String   @db.VarChar(50) // "ai_glm_4_6", "manual"
  createdAt DateTime @default(now())

  @@unique([level, parentKey])
  @@map("vehicle_taxonomy")
}

// Cached scrape results, keyed by spec hash so multiple users sharing the
// same vehicle spec don't trigger redundant scrapes. Populated by the
// 5-day cron (live snapshots) and the per-asset backfill job (Web Archive).
//
// `specHash` is sha256(year|make|model|trim) so equality lookups are stable.
// `listings` is JSON: [{price, currency, year, mileage, trim, url}, ...]
// for vehicles, or [{price, currency, areaM2, bedrooms, bathrooms, ...}]
// for properties (the asset type is implicit in how the snapshot is queried).
//
// `archiveDate` is set only for `source IN ('web_archive', ...)` rows where
// the snapshot represents a specific historical timestamp; null for live
// scrapes.
model SpecMarketSnapshot {
  id          String    @id @default(cuid())
  specHash    String    @db.VarChar(64)
  year        Int
  make        String    @db.VarChar(100)
  model       String    @db.VarChar(100)
  trim        String?   @db.VarChar(100)
  scrapedAt   DateTime  @default(now())
  source      String    @db.VarChar(50) // "standvirtual_live" | "olx_live" | "web_archive" | "idealista_live" | "imovirtual_live"
  archiveDate DateTime?
  listings    Json
  sampleSize  Int       @default(0)

  // Reverse side of the optional FK from ValuationHistory.
  valuationRows ValuationHistory[]

  @@index([specHash, scrapedAt])
  @@index([source, scrapedAt])
  @@map("spec_market_snapshots")
}

// Per-URL liveness for scraped listings. Populated by a daily cron that
// HEAD-checks listing URLs across all SpecMarketSnapshot rows. Deduped by
// URL so multiple users sharing the same Idealista listing only cost one
// HTTP check.
model ListingHealthCheck {
  url         String   @id @db.VarChar(500)
  source      String?  @db.VarChar(50) // "idealista" | "imovirtual" | "standvirtual" | "olx"
  status      String   @db.VarChar(20) // "alive" | "dead" | "unknown"
  lastChecked DateTime @default(now())
  // Last HTTP status code seen, for diagnostics. Null when the request never
  // resolved (timeout / network error / proxy block).
  httpStatus  Int?

  @@index([lastChecked])
  @@index([status, lastChecked])
  @@map("listing_health_checks")
}

// Quarterly housing price index by Portuguese concelho (município).
// Source: INE (Instituto Nacional de Estatística) — quarterly indicator.
// `concelhoKey` is the lowercased + ASCII-folded concelho name used for matching
// (e.g. "lisboa", "vila nova de gaia"). `indexValue` is treated as a relative
// index: only ratios between two rows for the same concelho carry meaning,
// so the engine works whether the underlying series is "median price per m²"
// or a unitless index.
model PropertyValuationIndex {
  id           String  @id @default(cuid())
  concelhoKey  String  @db.VarChar(120)
  concelhoName String  @db.VarChar(120)
  year         Int
  quarter      Int // 1..4
  indexValue   Decimal @db.Decimal(14, 4)
  source       String  @db.VarChar(50) // "INE", "manual"

  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([concelhoKey, year, quarter])
  @@index([concelhoKey])
  @@map("property_valuation_index")
}

model Liability {
  id                  String  @id @default(cuid())
  workspaceId         String
  realAssetId         String? // Nullable: standalone liabilities (credit cards, personal loans)
  recurringTemplateId String? // Nullable: linked monthly payment template

  type     LiabilityType
  name     String          @db.VarChar(255)
  status   LiabilityStatus @default(ACTIVE)
  currency String          @default("EUR") @db.VarChar(3)

  // Loan parameters
  principal      Decimal  @db.Decimal(14, 2)
  principalEur   Decimal  @db.Decimal(14, 2)
  interestRate   Decimal? @db.Decimal(7, 4) // Annual % e.g., 6.5000
  termMonths     Int?
  monthlyPayment Decimal? @db.Decimal(12, 2)
  startDate      DateTime

  // Computed (refreshed nightly via cron)
  currentBalance    Decimal @db.Decimal(14, 2)
  currentBalanceEur Decimal @db.Decimal(14, 2)

  // Relations
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  realAsset         RealAsset?         @relation(fields: [realAssetId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTemplate? @relation("LiabilityTemplate", fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([realAssetId])
  @@index([recurringTemplateId])
  @@map("liabilities")
}

// ============================================================================
// AI ADVISOR (Insights, retrospectives, nudges)
// ============================================================================

enum InsightType {
  RETROSPECTIVE // Day-1 monthly retrospective popup
  NUDGE_CATEGORIZE // "X expenses need a category" prompt
  NUDGE_KEYWORD // "Make Continente → Groceries a rule?" prompt
  NUDGE_RECURRING // "Spotify recurs monthly — add template?" prompt
  NUDGE_PROJECT // "These 4 expenses look like a project" prompt
}

enum InsightStatus {
  OPEN // Active, surfaced to the user
  ACCEPTED // User acted on it (created rule, tagged, etc.) — never returns for same scope
  DISMISSED // User dismissed; respect snoozeUntil before regenerating
  EXPIRED // Time-bound (e.g. retrospective for an old month) and no longer surfaced
}

model Insight {
  id          String        @id @default(cuid())
  workspaceId String
  type        InsightType
  status      InsightStatus @default(OPEN)

  generatedAt DateTime  @default(now())
  readAt      DateTime? // For RETROSPECTIVE: when user opened the popup
  dismissedAt DateTime?
  snoozeUntil DateTime? // Suppress re-detection until this timestamp

  content   Json // Structured LLM output (headline + observations, or per-row guesses)
  payload   Json // Pre-aggregated stats sent to the LLM (audit trail + dedupe input)
  inputHash String @db.VarChar(64) // sha256 of payload — idempotency key for cron generation

  // Period (RETROSPECTIVE only)
  periodYear  Int?
  periodMonth Int? // 1..12

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, type, status])
  @@index([workspaceId, periodYear, periodMonth])
  @@index([workspaceId, snoozeUntil])
  @@index([workspaceId, type, inputHash])
  @@map("insights")
}
