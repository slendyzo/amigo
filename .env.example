# Database connection string (PostgreSQL)
# Docker: postgresql://amigo:password@db:5432/amigo
# Host:   postgresql://amigo:password@localhost:5432/amigo
DATABASE_URL="postgresql://amigo:password@db:5432/amigo"

# Postgres password (used by docker-compose for the db service)
POSTGRES_PASSWORD="generate-a-password-with-openssl-rand-base64-24"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
